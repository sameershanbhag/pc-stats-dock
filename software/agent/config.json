    {
      "id": "app3",
      "label": "Music",
      "sub": "play / pause",
      "glyph": "⏯",
      "type": "applescript",
      "command": "tell application \"Music\" to playpause"
    },
    {
      "id": "mic",
      "label": "Mic",
      "sub": "mute toggle",
      "glyph": "●",
      "type": "mic"
    },
    {
      "id": "vol-down",
      "label": "Volume",
