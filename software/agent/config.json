      "glyph": "⧉",
      "type": "hotkey",
      "keys": [
        "ctrl",
        "up"
      ]
    },
    {
      "id": "desktop",
      "label": "Show desktop",
      "sub": "",
      "glyph": "▁",
      "type": "hotkey",
      "keys": [
        "f11"
      ]
    },
    {
      "id": "spotlight",
      "label": "Spotlight",
